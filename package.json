    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.1.5",
